#!name= 流媒体解锁测试 v2
#!desc= https://streaming.test

# ============================================================
# 流媒体与 AI 解锁检测 v2（基于 Sage 原版改进）
# 改进点：
#  1. 前端重写：图标全部内联 SVG（零外链），分组展示，新增一键全测
#  2. Netflix 双片名检测：区分自制剧 / 非自制 / 完整全库
#  3. 新增 AI 检测：Muse、Claude、Gemini（原版只有 ChatGPT）
#
# ⚠️ 部署说明（必读）：
#  下面标 [占位] 的 5 个 script-path 指向你自己的托管地址，
#  安装前必须把
#    https://cdn.jsdelivr.net/gh/Suxiami/streaming-test-v2@main/
#  替换成你真实的地址，例如你传到 GitHub 后的 raw 链接：
#    https://raw.githubusercontent.com/你的用户名/你的仓库/main/streaming-test/v2/front-end-v2.js?v=262
#  其他未改动的服务仍沿用 Sage 原版 GitHub 地址，不用动。
#  也可以把全部 JS 文件传到同一个地方，再把所有 script-path 统一改掉。
# ============================================================

[Script]

Bahamut = type=http-request, pattern=^https:\/\/streaming\.test\/bahamut\/?$, script-path=https://raw.githubusercontent.com/huskydsb/Shadowrocket/main/Streaming/js/bahamuts.js, timeout=60

Steam = type=http-request, pattern=^https:\/\/streaming\.test\/steam\/?$, script-path=https://cdn.jsdelivr.net/gh/Suxiami/streaming-test-v2@main/steam-v2.js, timeout=60

